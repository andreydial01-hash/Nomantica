# Copia este archivo como .env en el droplet (nunca se sube a git)
NODE_ENV=production
PORT=3050
# Acceso al /admin. El hash se genera con: npm run password -- "tu-contraseña-larga"
ADMIN_EMAIL=andreydial01@gmail.com
ADMIN_PASSWORD_HASH=
# Base de datos (fuera de la carpeta pública)
DB_FILE=/var/lib/nomantica/leads.db
# Aviso opcional por correo (Resend). Si se deja vacío, no se envía nada.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=Nomántica <leads@nomantica.com.mx>
# minimal = solo avisa y manda a /admin · full = incluye nombre y WhatsApp
NOTIFY_DETAIL=minimal
SITE_URL=https://nomantica.com.mx
